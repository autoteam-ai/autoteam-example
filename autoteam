#!/usr/bin/env bash
# autoteam 命令入口。角色指令里一律写 `bash ./autoteam <命令>`（开工先检查暂停、部署后同步指令
# 都靠它），所以仓库根目录必须有这个文件。
#
# 用哪一版 autoteam：
#   1. 本机用 `npx skills add autoteam-ai/autoteam --skill autoteam` 装过，就用 .claude/skills/autoteam
#   2. 否则用下面固定的提交（和本仓库接入时的版本一致），首次运行下载到 ~/.cache/autoteam/cli/<提交>。
#      agent 每次都是新 checkout，没有本机 skill，走的是这一条
# 升级 autoteam（npx skills update + autoteam upgrade）时，把 AUTOTEAM_REF 一起改成新版本的提交。
set -euo pipefail

AUTOTEAM_REF=${AUTOTEAM_REF:-af7a544960b6d18bd0cbb518df1442c3f7820476}

root=$(cd "$(dirname "$0")" && pwd)
if [ -f "$root/.claude/skills/autoteam/bin/autoteam" ]; then
  exec bash "$root/.claude/skills/autoteam/bin/autoteam" "$@"
fi

cache=${XDG_CACHE_HOME:-$HOME/.cache}/autoteam/cli/$AUTOTEAM_REF
if [ ! -f "$cache/skills/autoteam/bin/autoteam" ]; then
  mkdir -p "${cache%/*}"
  # 先解压到临时目录再改名：几个 agent 同时第一次运行时，谁也看不到解压了一半的目录
  tmp=$(mktemp -d "$cache.XXXXXX")
  if ! curl -fsSL "https://codeload.github.com/autoteam-ai/autoteam/tar.gz/$AUTOTEAM_REF" | tar -xz -C "$tmp" --strip-components=1; then
    rm -rf "$tmp"
    echo "下载 autoteam $AUTOTEAM_REF 失败" >&2
    exit 1
  fi
  # 别人先解压好了就用别人的（目标已存在时 mv 会把临时目录挪进去，而不是报错）
  if [ -e "$cache" ]; then rm -rf "$tmp"; else mv "$tmp" "$cache"; fi
fi
exec bash "$cache/skills/autoteam/bin/autoteam" "$@"
